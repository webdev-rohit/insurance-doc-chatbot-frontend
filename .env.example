# Base URL of the FastAPI backend the SPA calls at runtime.
# Leave EMPTY to use the Vite dev proxy (recommended for local dev): requests to
# /auth, /ingestion, /query, /chat are forwarded to VITE_DEV_PROXY_TARGET below.
# For a deployed build, set this to the backend origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Where the dev proxy forwards API calls (only used by `npm run dev`).
VITE_DEV_PROXY_TARGET=http://localhost:8000
