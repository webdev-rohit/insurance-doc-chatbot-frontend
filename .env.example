# Env vars are split across Vite's mode-specific files, which load automatically
# — no manual switching needed:
#   .env              shared defaults for every mode (usually left empty)
#   .env.development  used by `npm run dev`                  (mode=development)
#   .env.production   used by `npm run build` / `npm run preview` (mode=production)
#
# This file just documents the variables; copy the relevant one(s) into the
# mode-specific file if you need to override a default.

# Ingestion service base URL — handles /ingestion* only.
# Empty in development (dev proxy handles it); set for production.
VITE_INGESTION_API_BASE_URL=

# Query service base URL — handles /auth*, /query*, /chat*.
# Empty in development (dev proxy handles it); set for production.
VITE_QUERY_API_BASE_URL=

# Where the dev proxy forwards API calls (development only — ignored in prod).
VITE_DEV_PROXY_INGESTION_TARGET=http://localhost:8000
VITE_DEV_PROXY_QUERY_TARGET=http://localhost:8000
