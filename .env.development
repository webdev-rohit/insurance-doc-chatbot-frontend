# Loaded automatically by `npm run dev` (vite runs in mode=development).
# Leave the two API base URLs empty so the client calls relative paths, which
# the Vite dev proxy below forwards to a locally-running backend.
VITE_INGESTION_API_BASE_URL=
VITE_QUERY_API_BASE_URL=

# Local backend the dev proxy forwards /ingestion* and /auth*, /query*, /chat* to.
VITE_DEV_PROXY_INGESTION_TARGET=http://localhost:8000
VITE_DEV_PROXY_QUERY_TARGET=http://localhost:8000
